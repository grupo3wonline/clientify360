includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - app
        - database
        - routes

    # Diretórios/arquivos fora da análise estática.
    excludePaths:
        - app/Http/Controllers/Auth/*

    ignoreErrors:
        # Métodos mágicos de Eloquent/relacionamentos geram falsos positivos conhecidos.
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\(Builder|Relations\\[a-zA-Z]+)#'
