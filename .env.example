APP_NAME=Clientify360
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# HostGator: use MySQL (crie o banco no cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seu_banco
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção deve ser true; deixe a linha ausente no .env local (http).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Busca global (Laravel Scout) usando o próprio banco, sem serviço externo
SCOUT_DRIVER=database

# Limites de requisições por minuto (site público, área logada e API)
PUBLIC_RATE_LIMIT=60
APP_RATE_LIMIT=120
API_RATE_LIMIT=60

# Documentação OpenAPI: gere o JSON manualmente (php artisan l5-swagger:generate)
L5_SWAGGER_GENERATE_ALWAYS=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail transacional (cadastro, ativação da conta, recuperação de senha) via SMTP da HostGator.
# 1) No cPanel > Contas de E-mail, crie a caixa (ex.: nao-responder@seudominio.com.br).
# 2) MAIL_HOST: com SSL, use o servidor da HOSPEDAGEM (o mesmo "nome do servidor" do cPanel,
#    ex.: sh-pro32.hostgator.com.br), cujo certificado é válido. "mail.seudominio.com.br"
#    costuma falhar na validação do certificado.
# 3) Porta 465 + MAIL_SCHEME=smtps (SSL). A porta 25 é bloqueada no Brasil.
# 4) MAIL_USERNAME é o endereço COMPLETO da caixa e MAIL_FROM_ADDRESS deve ser o mesmo
#    endereço (ou do mesmo domínio): senão o SPF/DKIM reprova e o e-mail cai no spam.
# Valide com: php artisan mail:test seu@email.com
MAIL_MAILER=smtp
MAIL_HOST=sh-proXX.hostgator.com.br
MAIL_PORT=465
MAIL_USERNAME=nao-responder@seudominio.com.br
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="nao-responder@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFESSIONAL_PRICE_ID=
CASHIER_CURRENCY=brl
CASHIER_CURRENCY_LOCALE=pt_BR

# Analytics / Medição (SEO/SEM/geomarketing) — deixe em branco para desativar
GTM_ID=
GA4_ID=
GOOGLE_SITE_VERIFICATION=

# Google reCAPTCHA v3 (clássico, NÃO Enterprise). Deixe as chaves em branco para
# desativar a verificação (ex.: ambiente de desenvolvimento). Com as chaves
# preenchidas a verificação passa a ser obrigatória no login, cadastro,
# recuperação de senha e formulário público de leads.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Cloudflare Turnstile (complementa o reCAPTCHA nos mesmos formulários). Crie um widget em
# dash.cloudflare.com > Turnstile, com o domínio do site, e copie as duas chaves. Deixe em branco
# para desativar (ex.: desenvolvimento). Com a chave secreta preenchida a verificação é obrigatória;
# preencha SEMPRE as duas chaves (a do site desenha o widget, a secreta valida no servidor).
# Chaves de teste da Cloudflare (sempre passam): site 1x00000000000000000000AA
# e secreta 1x0000000000000000000000000000000AA. Nunca use-as em produção.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Segurança de senha: validade (dias) e antecedência do lembrete de troca.
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_WARNING_DAYS=7
# Antecedência (dias) do lembrete de renovação da assinatura.
SUBSCRIPTION_WARNING_DAYS=7
