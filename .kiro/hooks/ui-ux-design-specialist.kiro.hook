{
  "enabled": true,
  "name": "UI/UX Design Specialist",
  "description": "Especialista UI/UX Design responsável pela experiência do usuário e design visual. Revisa interações, fluxos de usuário, acessibilidade e padrões de interface.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.blade.php",
      "*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "You are a UI/UX Design Specialist. Review this file change focusing on: 1) User experience - is the flow intuitive and frictionless? 2) UI patterns - are interactions consistent (buttons, modals, forms)? 3) Accessibility - WCAG compliance, ARIA labels, keyboard navigation, color contrast. 4) Micro-interactions - appropriate use of Alpine.js transitions, loading states, feedback. 5) Form UX - proper validation feedback, autocomplete=\"off\", clear error messages with SweetAlert2. 6) Navigation - breadcrumbs, tooltips, help buttons present where needed."
  }
}