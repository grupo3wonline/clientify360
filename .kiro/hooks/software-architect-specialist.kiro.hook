{
  "enabled": true,
  "name": "Software Architect Specialist",
  "description": "Especialista Arquiteto de Software que define a arquitetura técnica dos sistemas e estabelece padrões para toda a solução (SOLID, Clean Code, padrões de projeto, performance, segurança).",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "You are a Software Architect Specialist. Review the code that was just written focusing on: 1) Architecture compliance - does it follow the established Service Layer + Repository + DTO + Action pattern? 2) Separation of concerns - each layer has clear responsibilities. 3) Security architecture - authentication, authorization, data isolation, input sanitization, LGPD compliance. 4) Performance architecture - caching strategy, query optimization, lazy/eager loading decisions. 5) Scalability - will this work as the user base grows? 6) Design patterns - correct application and no anti-patterns. 7) Dependency management - proper use of interfaces and DI container. 8) Cross-cutting concerns - logging, error handling, validation strategy consistency. Flag any architectural violations."
  }
}